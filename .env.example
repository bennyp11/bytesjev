# Copy this file to .env in the project root and fill in the key.
# .env is gitignored and is the only place the key needs to live. A variable
# already set in your shell environment takes precedence over .env.

TYPESAFE_API_KEY=             # from https://typesafe.ai  (REQUIRED)
JEV_MODEL=jev-latest          # pin e.g. jev-1.13.0 once you are happy with the thresholds

# --- Optional, for the MCP server ---
# BYTESJEV_DEBUG=1            # one stderr line per call: status, item count, ms
# BYTESJEV_CACHE=1            # cache Jev answers on disk under .cache/jev (off by default)
# BYTESJEV_TIMEOUT_MS=20000   # per-call Jev timeout; the tool answers "unavailable" past it

# --- Optional, for the live dashboard (npm run viz) ---
# VIZ_PORT=4310               # port the dashboard listens on
# VIZ_URL=http://localhost:4310  # where the MCP server streams each call; unreachable is fine
