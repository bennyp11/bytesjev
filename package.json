{
  "name": "bytesjev",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "PlanningChecker: a local MCP server for Claude Code that asks Jev (TypeSafe System One) whether each item in the agent's plan is actually needed, with a live dashboard.",
  "keywords": ["mcp", "claude-code", "planning", "overengineering", "jev", "typesafe", "model-context-protocol"],
  "homepage": "https://github.com/bennyp11/bytesjev#readme",
  "repository": { "type": "git", "url": "git+https://github.com/bennyp11/bytesjev.git" },
  "bugs": { "url": "https://github.com/bennyp11/bytesjev/issues" },
  "author": "Ben Pollock",
  "bin": { "bytesjev": "dist/cli.js" },
  "files": ["dist", ".claude/skills", "README.md", "LICENSE", ".env.example"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/viz/index.html dist/viz/index.html && chmod +x dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "mcp": "tsx src/mcp/index.ts",
    "viz": "tsx src/viz/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:plan": "tsx scripts/smoke-planning.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
